{
  "name": "day-panel",
  "version": "1.4.3",
  "private": true,
  "description": "Your day, your habits, your notes and your spending, in one calm place on the desktop.",
  "main": "desktop/main.js",
  "scripts": {
    "start": "electron .",
    "icon": "node scripts/make-icon.js",
    "dist": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3"
  },
  "allowScripts": {
    "electron@33.4.11": true
  },
  "author": {
    "name": "blickff"
  },
  "license": "MIT",
  "build": {
    "appId": "com.dayPanel.app",
    "productName": "Daybook",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "index.html",
      "widget.html",
      "css/**/*",
      "js/**/*",
      "desktop/**/*",
      "!release/**",
      "!scripts/**",
      "!.repoboard/**",
      "!.claude/**",
      "!.github/**"
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Daybook",
      "uninstallDisplayName": "Daybook",
      "deleteAppDataOnUninstall": false,
      "artifactName": "Daybook-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Daybook-${version}-portable.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "blickff",
        "repo": "plan_C",
        "releaseType": "release"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "Daybook-${version}-mac.${ext}"
    },
    "dmg": {
      "title": "${productName} ${version}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icons",
      "category": "Utility",
      "executableName": "daybook",
      "synopsis": "Your day, your habits, your notes and your spending",
      "description": "A calm desktop panel for habits, tasks, notes and spending, with a widget for the desktop.",
      "maintainer": "blickff",
      "desktop": {
        "entry": {
          "Name": "Daybook",
          "StartupWMClass": "day-panel",
          "Keywords": "habits;tasks;notes;money;"
        }
      }
    },
    "appImage": {
      "artifactName": "Daybook-${version}.${ext}"
    },
    "rpm": {
      "artifactName": "Daybook-${version}.x86_64.${ext}",
      "fpm": [
        "--rpm-rpmbuild-define=_build_id_links none"
      ]
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
